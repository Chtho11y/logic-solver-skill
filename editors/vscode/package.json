{
  "name": "puzzle-dsl",
  "displayName": "Puzzle DSL",
  "description": "Language support for the puzzle constraint DSL: highlighting, hover, go-to-definition, diagnostics.",
  "version": "0.1.0",
  "publisher": "logic-solver",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:puzzle/lib",
    "onLanguage:puzzle-dsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "puzzle-dsl",
        "aliases": [
          "Puzzle DSL",
          "puzzle-dsl"
        ],
        "extensions": [
          ".dsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "puzzle-dsl",
        "scopeName": "source.puzzle-dsl",
        "path": "./syntaxes/puzzle-dsl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Puzzle DSL",
      "properties": {
        "puzzleDsl.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Puzzle DSL language server."
        },
        "puzzleDsl.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.10+ interpreter used to launch the language server. Empty = discover python3, then python."
        },
        "puzzleDsl.diagnostics.level": {
          "type": "string",
          "enum": [
            "off",
            "syntax",
            "semantic"
          ],
          "default": "semantic",
          "description": "syntax = lexer/parser errors on every .dsl file. semantic = also compile against impls/<key>.json + sample (impls only)."
        },
        "puzzleDsl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Puzzle DSL language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
