{
  "key": "isowatari",
  "en": "Isowatari",
  "zh": "渡池石块",
  "category": "涂黑II",
  "subcategory": "色块是nmino",
  "rule": "涂黑一些格子，使得每个涂黑的连通组均为N格骨牌（其中N是盘面右上角给定的数），且留白的格子连通成一个整体。有黑圈的格子必须涂黑，有白圈的格子必须留白。不能有全部留白的2×2结构。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 白圈, 2 = 黑圈"
    }
  ],
  "layers": [
    {
      "id": "circle_o",
      "label": "圆圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {
    "defaults": {
      "n": 3
    }
  },
  "notes": "完全实现：每个涂黑连通组恰 param(\"n\") 格 + 留白连通 + 无全白2x2 + 圆圈颜色。"
}
