{
  "key": "squarejam",
  "en": "Square Jam",
  "zh": "正方密铺",
  "category": "分区",
  "subcategory": "",
  "rule": "沿虚格线把盘面分成若干个正方形区域。每个顶点不能同时是四个正方形的一角。数字表示其所在的正方形的边长。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "c",
      "kind": "cell",
      "type": "cc",
      "doc": "区域划分"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "正方形边长"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "边长",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "partition",
      "label": "分区结果",
      "element": "region",
      "target": "cell",
      "role": "output",
      "var": "c"
    }
  ],
  "params": {},
  "notes": ""
}
