{
  "key": "roma",
  "en": "Roma",
  "zh": "罗马",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个空格中放置一个箭头（↑ ↓ ← → 之一），使得每个区域内的箭头各不相同。从任意一个带有箭头的格子开始，沿着箭头移动，最终一定可以到达一个黑圈。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "a",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        8
      ],
      "doc": "箭头 0-3，8=无"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=白圈 2=黑圈"
    },
    {
      "name": "dist",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        80
      ],
      "doc": "到目标的距离"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "circle",
      "label": "黑圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "answer",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "output",
      "var": "a"
    }
  ],
  "params": {},
  "notes": "每区箭头互异。沿箭头必达黑圈。dist 为辅助距离。"
}
