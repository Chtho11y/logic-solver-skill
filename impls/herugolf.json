      "type": "normal",
      "domain": [
        0,
        8
      ],
      "doc": "本杆剩余步数"
    },
    {
      "name": "s",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        8
      ],
      "doc": "本杆长度"
    },
    {
