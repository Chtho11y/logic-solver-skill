{
  "key": "renban",
  "en": "Renban-Madoguchi",
  "zh": "连番窗口",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个空格内填入一个正整数。每个区域内的所有数必须构成一个连续数字序列，顺序任意。被粗边框分隔的两个数之差必须等于分隔它们的边框的长度。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        1,
        12
      ],
      "doc": "1..N"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "given",
      "label": "已给数字",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "x",
      "options": {
        "min": 1
      }
    },
    {
      "id": "answer",
      "label": "填数",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {},
  "notes": "区域内连续；跨粗边框相邻两数之差=该段公共边界长度。"
}
