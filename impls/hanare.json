{
  "key": "hanare",
  "en": "Hanare-gumi",
  "zh": "差距一致",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个区域中的一格填上等于该区域面积的数字。若两个数字在同一行或同一列，且它们之间没有其他数字，则它们之间必须恰有N个空格，其中N为这两数之差。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        20
      ],
      "doc": "填数（0=空/黑）"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "answer",
      "label": "填数",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {},
  "notes": "每区一格填面积。同行/列且中间无其他数字时，中间空格数=两数之差。"
}
