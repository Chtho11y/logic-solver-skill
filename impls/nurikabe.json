{
  "key": "nurikabe",
  "en": "Nurikabe",
  "zh": "数墙",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些空格，使得所有涂黑的格子连通成一个整体，且没有全部涂黑的2×2结构。每一组连通的留白格必须恰好包含一个数字。数字表示其所在的留白的连通组格数。",
  "defaultRows": 10,
  "defaultCols": 10,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "数字提示"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "岛屿数字",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": ""
}
