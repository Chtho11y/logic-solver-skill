{
  "key": "toichika",
  "en": "Toichika",
  "zh": "山盟海誓",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个区域中放置一个箭头（↑ ↓ ← → 之一）。每个箭头都和另一个箭头配对，它们相互指向，它们之间不能有其他箭头。配对箭头所属的区域不能有公共边界。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "a",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        8
      ],
      "doc": "箭头 0-3，8=无"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "answer",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "output",
      "var": "a"
    }
  ],
  "params": {},
  "notes": "每区一箭头；箭头两两对射且中间无箭头；配对两区无公共边界。8=无。"
}
