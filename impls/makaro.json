{
  "key": "makaro",
  "en": "Makaro",
  "zh": "极大箭头",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个空格里填一个数，使得每个区域里包含数字1~N，其中N是这个区域的总格数。相邻的格子里不能填相同的数字。黑格里的箭头必须指向所有与此格相邻的数字中唯一最大的一个。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        20
      ],
      "doc": "填数（0=空/黑）"
    },
    {
      "name": "b",
      "kind": "cell",
      "type": "constant",
      "doc": "1=黑格/墙"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头方向"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "shade",
      "label": "黑格",
      "element": "shade",
      "target": "cell",
      "role": "input",
      "var": "b",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    },
    {
      "id": "arrow",
      "label": "极大箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "answer",
      "label": "填数",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {},
  "notes": "白格区域 1..N；相邻不同。黑格箭头指向邻接数字中唯一最大者。"
}
