{
  "key": "makaro",
  "en": "Makaro",
  "zh": "极大箭头",
  "category": "填写",
  "subcategory": "",
  "rule": "在每个空格里填一个数，使得每个区域里包含数字1~N，其中N是这个区域的总格数。相邻的格子里不能填相同的数字。黑格里的箭头必须指向所有与此格相邻的数字中唯一最大的一个。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        16
      ],
      "doc": "0 = 黑格/箭头格"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头 0-3"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "arrow_d",
      "label": "极大箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "given",
      "label": "已给数字",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "x",
      "options": {
        "min": 1,
        "max": 16
      }
    },
    {
      "id": "answer",
      "label": "解",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {},
  "notes": "箭头格不填数。0=上 1=下 2=左 3=右。"
}
