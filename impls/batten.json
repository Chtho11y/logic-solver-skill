{
  "key": "batten",
  "en": "Battenberg Painting",
  "zh": "双色蛋糕",
  "category": "涂黑III",
  "subcategory": "",
  "rule": "涂黑一些格子，使得盘面外的数字表示此行或此列内涂黑格的个数。所有呈黑白相间棋盘格图案的2×2区域都已被标记。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "m",
      "kind": "cell",
      "type": "constant",
      "doc": "2x2 棋盘格标记（写在左上格）"
    }
  ],
  "layers": [
    {
      "id": "outside",
      "label": "行列涂黑数",
      "element": "outside",
      "target": "outside",
      "role": "input",
      "param": "outside",
      "options": {
        "sides": [
          "top",
          "left"
        ],
        "mode": "int"
      }
    },
    {
      "id": "circle",
      "label": "棋盘格 2x2",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "m",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {
    "defaults": {
      "top": [],
      "left": []
    }
  },
  "notes": "m 标在 2×2 的左上格。标记与棋盘格 2×2 双射。"
}
