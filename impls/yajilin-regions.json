{
  "key": "yajilin-regions",
  "en": "Regional Yajilin",
  "zh": "仙人指区",
  "category": "回路II",
  "subcategory": "",
  "rule": "画一条横平竖直地经过一些空格中心且不和自身交叉的回路，并把未经过的空格涂黑。涂黑的格子不能相邻。数字表示此区域内的黑格数。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "区域内黑格数"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "clue",
      "label": "数字提示",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": ""
}
