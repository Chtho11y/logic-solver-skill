{
  "key": "creek",
  "en": "Creek",
  "zh": "溪流",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得留白的格子连通成一个整体。圆圈里的数字表示接触此顶点的涂黑格数。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "corner",
      "type": "constant",
      "doc": "顶点周围黑格数"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "顶点数字",
      "element": "number",
      "target": "corner",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0,
        "max": 4
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "提示写在格点 (corner) 上，取值 0-4。"
}
