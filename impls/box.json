{
  "key": "box",
  "en": "Box/Kakurasu",
  "zh": "方阵和",
  "category": "涂黑II",
  "subcategory": "见Aquarium",
  "rule": "涂黑一些空格，使得盘面外的数字等于此行或此列中涂黑格所在列号或行号（盘面外圆圈内的数字）的和。",
  "defaultRows": 7,
  "defaultCols": 7,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    }
  ],
  "layers": [
    {
      "id": "outside",
      "label": "行/列加权和",
      "element": "outside",
      "target": "outside",
      "role": "input",
      "param": "outside",
      "options": {
        "sides": [
          "top",
          "left"
        ],
        "mode": "int"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {
    "defaults": {
      "top": [],
      "left": []
    }
  },
  "notes": "left[r] = 该行涂黑格的列号之和；top[c] = 该列涂黑格的行号之和（均从 1 开始）。"
}
