{
  "key": "mochinyoro",
  "en": "Mochinyoro",
  "zh": "藕断丝弯",
  "category": "涂黑II",
  "subcategory": "见Mochikoro",
  "rule": "涂黑一些空格，使得没有全部涂黑的2×2结构。所有留白格必须对角连通成一个整体，且每一组连通的留白格必须是一个长方形。每一组连通的留白格至多包含一个数字。数字表示其所在的留白的连通组格数。任意一组连通的涂黑格都不能是长方形。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "留白连通组格数"
    }
  ],
  "layers": [
    {
      "id": "clue_n",
      "label": "留白组格数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "部分实现：无全黑2x2 + 留白对角连通 + 留白组为长方形 + 每组至多一个数字 + 组格数。「任意涂黑连通组都不是长方形」未编码。"
}
