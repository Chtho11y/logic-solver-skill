{
  "key": "snake",
  "en": "Snake",
  "zh": "数蛇",
  "category": "涂黑II",
  "subcategory": "色块是一条蛇",
  "rule": "涂黑一条宽度为一且不和自身接触的蛇。黑圈表示此格是蛇的一端，白圈表示此格是蛇身的一部分（但不是一端）。盘面外的数字表示此行或此列内涂黑格的个数。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "2 = 黑圈(端点), 1 = 白圈(蛇身)"
    }
  ],
  "layers": [
    {
      "id": "circle_o",
      "label": "端点/蛇身",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "完全实现：蛇形 + 端点/蛇身圆圈 + 盘外行列计数（param left/top）。「不与自身对角接触」仅由无 2x2 部分保证。"
}
