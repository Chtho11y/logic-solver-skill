{
  "key": "alternate",
  "en": "Alternate Loop",
  "zh": "交替回路",
  "category": "回路II",
  "subcategory": "",
  "rule": "画一条横平竖直地经过所有格子中心且不和自身交叉的回路。回路连续经过的任意两个圆圈颜色不能相同。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=白圈 2=黑圈"
    }
  ],
  "layers": [
    {
      "id": "circle",
      "label": "圆圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": "部分实现：仅约束被回路边直接相连的圆圈异色。沿回路隔格连续的同色圆圈未编码。"
}
