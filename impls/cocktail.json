{
  "key": "cocktail",
  "en": "Cocktail Lamp",
  "zh": "鸡尾酒灯",
  "category": "涂黑III",
  "subcategory": "黑块对角连通",
  "rule": "在每个区域内涂黑至多一组连通的格子，使得不同区域内涂黑的连通组不相邻。数字表示区域内涂黑格的个数。所有涂黑格必须对角连通成一个整体。不能有全部涂黑的2×2结构。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "区域内涂黑格数"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "clue",
      "label": "数字提示",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": ""
}
