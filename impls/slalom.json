{
  "key": "slalom",
  "en": "Slalom",
  "zh": "巡行通关",
  "category": "回路I",
  "subcategory": "",
  "rule": "画一条横平竖直地经过一些白格中心且不和自身交叉的有向回路，其中起点和终点都在圆圈的格子。回路必须直行通过每个用粗虚线标记的“关卡”恰好一次。黑格里带数字的箭头表示回路从圆圈出发后经过其指向的关卡的次序。盘面中的总关卡数在圈内给出。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=起点圆圈"
    },
    {
      "name": "w",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 特殊地形"
    },
    {
      "name": "g",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 关卡"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "关卡总数"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头方向"
    }
  ],
  "layers": [
    {
      "id": "given_w",
      "label": "黑格",
      "element": "shade",
      "target": "cell",
      "role": "input",
      "var": "w",
      "palette": {
        "1": "#232733"
      }
    },
    {
      "id": "given_g",
      "label": "关卡",
      "element": "shade",
      "target": "cell",
      "role": "input",
      "var": "g",
      "palette": {
        "1": "#9aa4b2"
      }
    },
    {
      "id": "circle",
      "label": "圆圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "arrow",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "clue",
      "label": "数字提示",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": "部分实现：不经黑格、经过圆圈、关卡直行；圆圈数字=关卡数。有向次序未编码。",
  "unencodedClues": [
    "d"
  ]
}
