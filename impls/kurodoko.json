{
  "key": "kurodoko",
  "en": "Kurodoko",
  "zh": "田鼠挖洞",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得涂黑的格子之间不相邻，且留白的格子连通成一个整体。白圈里的数字必须在留白格里，并表示此格横竖能够直接连接到且不被涂黑格阻挡的留白格个数，包括此格本身。",
  "defaultRows": 9,
  "defaultCols": 9,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "数字提示"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "可见留白格数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": ""
}
