{
  "key": "tetrochaink",
  "en": "Tetro Chain-K",
  "zh": "四格骨牌链(暗)",
  "category": "涂黑II",
  "subcategory": "色块是4mino",
  "rule": "涂黑一些格子，使得每个涂黑的连通组均为四格骨牌。所有四格骨牌对角连通，任意两个对角相邻的四格骨牌不能全等。盘面内的点提示了其所接触的（至多）四格中涂黑格和留白格哪种更多：白色表示留白格更多，黑色表示涂黑格更多，灰色表示涂黑格和留白格一样多。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "t",
      "kind": "cell",
      "type": "constant",
      "doc": "点提示 1=白多 2=黑多 3=相等"
    }
  ],
  "layers": [
    {
      "id": "circle_t",
      "label": "点提示 1=白多 2=黑多 3=相等",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "t",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "部分实现：每个涂黑连通组恰 4 格 + 对角连通 + 点提示黑白多寡。「对角相邻的两个四格骨牌不能全等」未编码。"
}
