{
  "key": "usoone",
  "en": "Uso-One",
  "zh": "单一谎言",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得涂黑的格子之间不相邻，且留白的格子连通成一个整体。数字表示与之相邻的（至多）四格中涂黑格的个数。数字格不能涂黑。每个区域内都恰好有一个错误的数字。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "相邻涂黑格数（每区域恰有一个是错的）"
    }
  ],
  "layers": [
    {
      "id": "clue_n",
      "label": "相邻涂黑格数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    },
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    }
  ],
  "params": {},
  "notes": "完全实现：含「每区域恰好一个错误数字」。"
}
