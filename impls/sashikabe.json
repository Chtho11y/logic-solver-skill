{
  "key": "sashikabe",
  "en": "Sashikabe",
  "zh": "曲尺数墙",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些空格，使得所有涂黑的格子连通成一个整体，且没有全部涂黑的2×2结构。每一组连通的留白格必须是宽度为一的L形区域。圆圈必须在L形留白区域内转弯的位置，而箭头则必须在留白区域的一端，指向转弯的位置。圆圈里的数字表示其所在留白区域的面积。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "留白区域面积"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头方向 0=上 1=下 2=左 3=右"
    }
  ],
  "layers": [
    {
      "id": "clue_n",
      "label": "留白区域面积",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "arrow_d",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "部分实现：涂黑连通 + 无全黑2x2 + 留白宽度为一。「恰好 L 形（仅一次转弯）」与圆圈/箭头定位、面积数字未编码。",
  "unencodedClues": [
    "n",
    "d"
  ]
}
