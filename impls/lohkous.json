      "kind": "cell",
      "type": "constant",
      "doc": "段长 1"
    },
    {
      "name": "n2",
      "kind": "cell",
      "type": "constant",
      "doc": "段长 2"
    },
    {
      "name": "n3",
      "kind": "cell",
      "type": "constant",
      "doc": "段长 3"
    }
  ],
  "layers": [
    {
      "id": "n1",
      "label": "段长1",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n1",
      "options": {
        "min": 0
      }
    },
    {
      "id": "n2",
      "label": "段长2",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n2",
      "options": {
        "min": 0
      }
    },
    {
      "id": "n3",
      "label": "段长3",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n3",
      "options": {
        "min": 0
      }
    },
    {
      "id": "partition",
      "label": "分区结果",
      "element": "region",
      "target": "cell",
      "role": "output",
      "var": "c"
    }
  ],
  "params": {},
  "notes": "一格可写最多三个不重复段长，等于该区所有横纵段长的集合。"
