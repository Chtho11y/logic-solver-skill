{
  "key": "doppelblock",
  "en": "Doppelblock",
  "zh": "双黑格",
  "category": "填写",
  "subcategory": "",
  "rule": "在格子内填入数字和黑格，使得每行每列均包含1~N-2和两个黑格（N为盘面边长）。盘面外的数字表示该行/列两个黑格之间的所有数字之和。",
  "defaultRows": 6,
  "defaultCols": 6,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        9
      ],
      "doc": "0 = 黑格"
    }
  ],
  "layers": [
    {
      "id": "outside",
      "label": "两黑格之间的和",
      "element": "outside",
      "target": "outside",
      "role": "input",
      "param": "outside",
      "options": {
        "sides": [
          "left",
          "top"
        ],
        "mode": "int"
      }
    },
    {
      "id": "answer",
      "label": "解",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {
    "defaults": {
      "left": [],
      "top": []
    }
  },
  "notes": "0 表示黑格。left[r] / top[c] 为该行/列两黑格之间的数字之和。"
}
