{
  "key": "oneroom",
  "en": "One Room One Door",
  "zh": "单房门",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得涂黑的格子之间不相邻，且留白的格子连通成一个整体。每个区域中的留白格也需要连通成一个整体。数字表示此区域内涂黑格的个数。对于任意两个相邻的区域，不能有超过一对相邻留白格穿过它们相邻的边界。（也就是说，每两个“房间”至多有一扇“门”沟通）。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "区域内涂黑格数"
    }
  ],
  "layers": [
    {
      "id": "clue_n",
      "label": "区域内涂黑格数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    },
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    }
  ],
  "params": {},
  "notes": "完全实现：island_rule + 区域涂黑数 + 相邻区域至多一扇门 + 区内留白连通（cc_count_in(x,0,reg)<=1）。"
}
