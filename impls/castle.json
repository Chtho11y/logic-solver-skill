{
  "key": "castle",
  "en": "Castle Wall",
  "zh": "城堡墙",
  "category": "回路I",
  "subcategory": "",
  "rule": "画一条横平竖直地经过一些空格中心且不和自身交叉的回路。黑格或白格内带箭头的数字表示从此格开始按照这个方向的所有直线段的总长度。有这些提示数的黑格必须在回路外，白格必须在回路内。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=白格(内) 2=黑格(外)"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "该方向回路格数"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头方向"
    },
    {
      "name": "ins",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路内部"
    },
    {
      "name": "y",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 不在回路上（辅助）"
    }
  ],
  "layers": [
    {
      "id": "circle",
      "label": "黑白格",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "arrow",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "clue",
      "label": "数字提示",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": "箭头数字按该方向上回路经过的格子计数。ins/y 为内部判定辅助变量。"
}
