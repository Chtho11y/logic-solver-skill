{
  "key": "mintonette",
  "en": "Mintonette",
  "zh": "排球/数弯",
  "category": "路径II",
  "subcategory": "",
  "rule": "用横平竖直地经过格子中心的路径把圆圈两两连接配对，使得每个圈都恰好属于一对。路径不能和自身或互相交叉，包括在端点交叉。每个格子必须恰好有一条路径经过。圆圈里的数字表示其路径转弯的次数。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 路径"
    },
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        20
      ],
      "doc": "配对编号"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 圆圈"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "路径转弯次数"
    }
  ],
  "layers": [
    {
      "id": "circle",
      "label": "圆圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "clue",
      "label": "转弯数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "pair",
      "label": "配对编号",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x"
    },
    {
      "id": "loop",
      "label": "路径",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": "覆盖全部格子的两两配对；数字=该路径转弯格数。"
}
