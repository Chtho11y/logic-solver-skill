{
  "key": "oasis",
  "en": "Oasis",
  "zh": "绿洲",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得涂黑的格子之间不相邻，且留白的格子连通成一个整体。不能有全部留白的2×2结构。有白圈的格子必须留白。白圈里的数字表示从此格出发，在只经过空白格的情况下，可以走到的白圈个数。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "可走到的白圈个数"
    }
  ],
  "layers": [
    {
      "id": "clue_n",
      "label": "可走到的白圈数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "部分实现：island_rule + 无全白2x2 + 白圈格留白。「沿留白格可走到的白圈个数」是可达性计数，未编码。"
}
