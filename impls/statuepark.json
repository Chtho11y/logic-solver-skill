{
  "key": "statuepark",
  "en": "Statue Park",
  "zh": "雕像公园",
  "category": "放置",
  "subcategory": "放置",
  "rule": "把给出的形状放入盘面，使得任意两个形状不重叠也不相邻（但可以对角接触），而且剩下的没有被覆盖的格子连通成一个整体。形状可以旋转或翻转。有黑圈的格子必须被某个形状覆盖，而有白圈的格子不能被覆盖。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 被形状覆盖"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=白圈 2=黑圈"
    }
  ],
  "layers": [
    {
      "id": "circle",
      "label": "圆圈",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "部分实现：五格骨牌 + 留白连通 + 圆圈。给出的形状目录未编码。",
  "unencodedClues": [
    "shapes"
  ]
}
