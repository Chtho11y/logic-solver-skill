{
  "key": "yajikazu",
  "en": "Yajisan-Kazusan",
  "zh": "真假仙人",
  "category": "涂黑I",
  "subcategory": "颜色正交连通",
  "rule": "涂黑一些格子，使得涂黑的格子之间不相邻，且留白的格子连通成一个整体。在留白格内有箭头的数字表示从此格开始在这个方向中涂黑格的个数。这些提示数在涂黑格里则不提供信息。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "d",
      "kind": "cell",
      "type": "constant",
      "doc": "箭头方向 0=上 1=下 2=左 3=右"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "该方向涂黑格数"
    }
  ],
  "layers": [
    {
      "id": "arrow_d",
      "label": "箭头",
      "element": "arrow",
      "target": "cell",
      "role": "input",
      "var": "d"
    },
    {
      "id": "clue_n",
      "label": "该方向涂黑格数",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "完全实现：提示仅在其所在格留白时生效（涂黑时失效）。数字需与同格箭头方向成对给出。"
}
