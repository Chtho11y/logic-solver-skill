{
  "key": "magic",
  "en": "Magic Summer",
  "zh": "魔夏",
  "category": "填写",
  "subcategory": "",
  "rule": "在一些空格里填一个属于给出的列表中的数码，使得每个数码在每行和每列都恰好出现一次。盘面外的数字表示此行或此列中所有数码组成的数字之和，其中每一段多个连续的有数码的格子从左到右或从上到下形成一个多位数。有一些数码可能已经放入了盘面。有叉标记的格子不能填数。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        20
      ],
      "doc": "填数（0=空/黑）"
    },
    {
      "name": "m",
      "kind": "cell",
      "type": "constant",
      "doc": "1=叉/禁止填数"
    }
  ],
  "layers": [
    {
      "id": "outside",
      "label": "多位数之和",
      "element": "outside",
      "target": "outside",
      "role": "input",
      "param": "outside",
      "options": {
        "sides": [
          "top",
          "left"
        ],
        "mode": "int"
      }
    },
    {
      "id": "forbid",
      "label": "叉号",
      "element": "cross",
      "target": "cell",
      "role": "input",
      "var": "m"
    },
    {
      "id": "given",
      "label": "已给数码",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "x",
      "options": {
        "min": 0
      }
    },
    {
      "id": "answer",
      "label": "填数",
      "element": "number",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "*": "#1565c0"
      }
    }
  ],
  "params": {
    "defaults": {
      "values": [
        1,
        2
      ]
    }
  },
  "notes": "数码列表每行每列各一次。盘外=连续数码组成的多位数之和。叉格不填。"
}
