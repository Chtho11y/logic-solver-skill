{
  "key": "sansaroad",
  "en": "Sansa Road",
  "zh": "三叉路口",
  "category": "涂黑II",
  "subcategory": "色块是一条路",
  "rule": "涂黑一些空格，使得所有留白的格子连通成一个整体，且没有全部留白的2×2结构。盘面内的点提示了其所接触的（至多）四格中涂黑格和留白格哪种更多：白色表示留白格更多，黑色表示涂黑格更多，灰色表示涂黑格和留白格一样多。有白色三角形的格子（代表三叉路口）必须留白，且需要恰和三个留白格相邻。其余的留白格都必须恰和两个留白格相邻。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "t",
      "kind": "cell",
      "type": "constant",
      "doc": "点提示 1=白多 2=黑多 3=相等"
    },
    {
      "name": "v",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 白色三角形（三叉路口）"
    }
  ],
  "layers": [
    {
      "id": "circle_t",
      "label": "点提示 1=白多 2=黑多 3=相等",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "t",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "clue_v",
      "label": "三叉路口",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "v",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "完全实现：留白连通 + 无全白2x2 + 三叉路口度数 3 + 其余留白度数 2 + 点提示。注意：度数和必须为偶数，故盘面上的三叉路口个数必须是偶数，否则必然无解。"
}
