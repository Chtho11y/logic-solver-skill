{
  "key": "dominion",
  "en": "Dominion",
  "zh": "多米诺分区",
  "category": "涂黑II",
  "subcategory": "色块是多米诺",
  "rule": "涂黑一些1×2的长方形，将盘面分为若干个留白的区域。涂黑的长方形不能相邻。字母格不能涂黑。每个区域有且仅有一种字母，相同的字母都在同一个区域。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "x",
      "kind": "cell",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "0 = 留白, 1 = 涂黑"
    },
    {
      "name": "a",
      "kind": "cell",
      "type": "constant",
      "doc": "字母（同数字视为同字母）"
    }
  ],
  "layers": [
    {
      "id": "clue_a",
      "label": "字母",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "a",
      "options": {
        "min": 0
      }
    },
    {
      "id": "shade",
      "label": "涂黑",
      "element": "shade",
      "target": "cell",
      "role": "output",
      "var": "x",
      "palette": {
        "1": "#232733",
        "2": "#7f8ea3"
      }
    }
  ],
  "params": {},
  "notes": "完全实现：涂黑格两两成 1x2 骨牌且不同骨牌互不相邻 + 字母格留白 + 同字母同区域/异字母异区域。"
}
