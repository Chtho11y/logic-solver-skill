{
  "key": "moonsun",
  "en": "Moon or Sun",
  "zh": "日月交替",
  "category": "回路I",
  "subcategory": "",
  "rule": "画一条横平竖直地经过一些格子中心且不和自身交叉的回路。回路必须恰好经过每个区域一次，且在每个区域内至少经过一个符号。在每个区域内，回路必须要么经过所有太阳符号且不经过任何月亮符号，要么经过所有月亮符号且不经过任何太阳符号，且必须在连续经过的区域之间在两者之间切换。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": true,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "1=太阳 2=月亮"
    }
  ],
  "layers": [
    {
      "id": "regions",
      "label": "区域划分",
      "element": "region",
      "target": "cell",
      "role": "input",
      "var": "__regions"
    },
    {
      "id": "circle",
      "label": "日月",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": ""
}
