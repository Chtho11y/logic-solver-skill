{
  "key": "trainstations",
  "en": "Train Stations/Railroad",
  "zh": "铁轨",
  "category": "回路II",
  "subcategory": "",
  "rule": "画一条横平竖直地经过所有格子中心的回路。回路必须在且只能在含有十字的格子里与自身交叉。回路必须从1出发，按顺序经过所有数字格，且数字格处不允许拐弯。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "e",
      "kind": "edge",
      "type": "normal",
      "domain": [
        0,
        1
      ],
      "doc": "1 = 回路"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "车站编号"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "数字提示",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "loop",
      "label": "回路",
      "element": "link",
      "target": "edge",
      "role": "output",
      "var": "e"
    }
  ],
  "params": {},
  "notes": "部分实现：经过全部格子；仅数字格可自交；数字格不转弯。按 1..k 顺序经过未编码。"
}
