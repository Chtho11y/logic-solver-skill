{
  "key": "snakepit",
  "en": "Snake Pit",
  "zh": "蛇窝",
  "category": "分区",
  "subcategory": "",
  "rule": "沿虚格线把盘面分成若干个区域，使得任意两个相邻的区域面积都不同。格内的数字表示其所在区域的面积。所有区域必须都是宽为一且长度至少有两格的蛇形，且不能和自身接触。圆圈表示此格是某条蛇的一端，而灰格表示不是蛇的一端。",
  "defaultRows": 8,
  "defaultCols": 8,
  "usesRegions": false,
  "variables": [
    {
      "name": "c",
      "kind": "cell",
      "type": "cc",
      "doc": "区域划分"
    },
    {
      "name": "n",
      "kind": "cell",
      "type": "constant",
      "doc": "蛇长"
    },
    {
      "name": "o",
      "kind": "cell",
      "type": "constant",
      "doc": "蛇的一端"
    },
    {
      "name": "g",
      "kind": "cell",
      "type": "constant",
      "doc": "1 = 灰格（非端点）"
    }
  ],
  "layers": [
    {
      "id": "clue",
      "label": "蛇长",
      "element": "number",
      "target": "cell",
      "role": "input",
      "var": "n",
      "options": {
        "min": 0
      }
    },
    {
      "id": "circle",
      "label": "端点",
      "element": "circle",
      "target": "cell",
      "role": "input",
      "var": "o",
      "palette": {
        "1": "#ffffff",
        "2": "#232733",
        "3": "#9aa4b2"
      }
    },
    {
      "id": "gray",
      "label": "灰格",
      "element": "shade",
      "target": "cell",
      "role": "input",
      "var": "g",
      "palette": {
        "1": "#9aa4b2"
      }
    },
    {
      "id": "partition",
      "label": "分区结果",
      "element": "region",
      "target": "cell",
      "role": "output",
      "var": "c"
    }
  ],
  "params": {},
  "notes": ""
}
